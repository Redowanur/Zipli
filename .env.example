# Copy to .env and change the secrets before any non-local use.
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
JWT_SECRET=change-me-to-a-long-random-string
IP_SALT=change-me-salt
# Public base URL used to build short links
BASE_URL=http://localhost:8088
# Optional: "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this Authorized redirect URI:
#   <BASE_URL>/api/auth/google/callback      (local: http://localhost:8088/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Host port for the Nginx entry point
HTTP_PORT=8088

# --- Production only (docker-compose.prod.yml) ---
# DOMAIN=sho.example.com
# BASE_URL=https://sho.example.com
